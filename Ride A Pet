local function SafeUpdateElement(elem, title, desc)
    if not elem then return end
    pcall(function()
        if title and elem.SetTitle then elem:SetTitle(title) end
        if desc and elem.SetDesc then elem:SetDesc(desc) end
    end)
end

local function UpdateLanguage(lang)
    Config.Language = (lang == "English" and "English") or "Thai"

    local tabPairs = {
        { Tabs.EggFarm, GetText("TabEggFarm") },
        { Tabs.Ranch, GetText("TabRanch") },
        { Tabs.Passive, GetText("TabPassive") },
        { Tabs.Events, GetText("TabEvents") },
        { Tabs.Player, GetText("TabPlayer") },
        { Tabs.Settings, GetText("TabSettings") }
