-- 2. Precision Auto Teleport Egg Collector
task.spawn(function()
    local ServerData = ReplicatedStorage:FindFirstChild("ServerData") or ReplicatedStorage
    local ActiveEggs = ServerData:FindFirstChild("ActiveEggs")
    local EggPickup = GameRemotes:FindFirstChild("EggPickup")
    local renderedFolder = workspace:FindFirstChild("RenderedEggs")
    local failedEggs = {}

    local function ParsePosition(val)
        if typeof(val) == "Vector3" then return val end
        if type(val) == "string" then
            local c = string.split(val, ",")
            if #c == 3 then
                local x = tonumber(c[1])
                local y = tonumber(c[2])
                local z = tonumber(c[3])
                if x and y and z then return Vector3.new(x, y, z) end
            end
        end
        return nil
    end

    local function FindMatchingActiveEgg(eggName, pos)
        if not ActiveEggs then return nil end
        for _, aEgg in ipairs(ActiveEggs:GetChildren()) do
            if aEgg:GetAttribute("Egg") == eggName then
                local aPos = ParsePosition(aEgg:GetAttribute("Position"))
                if aPos and (Vector3.new(aPos.X, 0, aPos.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude < 4 then
                    return aEgg
                end
            end
        end
        return nil
    end

    while task.wait(0.15) and IsSessionAlive() do
        if (Config.TeleportCollectEggs or Config.SnipeVolcanicEgg) and EggPickup then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")

            if root then
                local curCount, maxCapacity = GetBasketInfo()
                if curCount >= maxCapacity then
                    ReturnToPlot()
                    local depositT0 = os.clock()
                    while #LocalPlayer.Basket:GetChildren() > 0 and (os.clock() - depositT0 < 3.5) and IsSessionAlive() do
                        task.wait(0.12)
                    end
                    task.wait(0.2)
                else
                    local nowTime = os.clock()
                    for id, expire in pairs(failedEggs) do
                        if nowTime > expire then
                            failedEggs[id] = nil
                        end
                    end

                    renderedFolder = workspace:FindFirstChild("RenderedEggs")
                    local candidates = {}

                    if renderedFolder then
                        for _, rEgg in ipairs(renderedFolder:GetChildren()) do
                            local eName = rEgg.Name
                            local rarity = EggsDB[eName] or "Common"
                            local isVolcanoEgg = Config.SnipeVolcanicEgg and (eName == "Volcanic Egg")
                            local isNormalTarget = Config.TeleportCollectEggs and (Config.SelectedRarities[rarity] == true)

                            if isVolcanoEgg or isNormalTarget then
                                local rPos = rEgg:GetPivot().Position
                                local active = FindMatchingActiveEgg(eName, rPos)
                                local activeId = active and active.Name or eName
                                if not failedEggs[activeId] then
                                    local prompt = rEgg:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    table.insert(candidates, {
                                        model = rEgg,
                                        name = eName,
                                        rarity = rarity,
                                        pos = rPos,
                                        activeName = active and active.Name,
                                        prompt = prompt,
                                        isVolcano = isVolcanoEgg,
                                        dist = (Vector3.new(rPos.X, 0, rPos.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude
                                    })
                                end
                            end
                        end
                    end

                    if #candidates == 0 and ActiveEggs then
                        local serverNow = workspace:GetServerTimeNow()
                        for _, aEgg in ipairs(ActiveEggs:GetChildren()) do
                            local eName = aEgg:GetAttribute("Egg")
                            local rarity = EggsDB[eName] or "Common"
                            local dropEnds = tonumber(aEgg:GetAttribute("DropEndsAt")) or 0
                            local aPos = ParsePosition(aEgg:GetAttribute("Position"))
                            local isVolcanoEgg = Config.SnipeVolcanicEgg and (eName == "Volcanic Egg")
                            local isNormalTarget = Config.TeleportCollectEggs and (Config.SelectedRarities[rarity] == true)

                            if (isVolcanoEgg or isNormalTarget) and dropEnds <= serverNow and aPos and not failedEggs[aEgg.Name] then
                                table.insert(candidates, {
                                    model = nil,
                                    name = eName,
                                    rarity = rarity,
                                    pos = aPos,
                                    activeName = aEgg.Name,
                                    prompt = nil,
                                    isVolcano = isVolcanoEgg,
                                    dist = (Vector3.new(aPos.X, 0, aPos.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude
                                })
                            end
                        end
                    end

                    if #candidates > 0 then
                        table.sort(candidates, function(a, b)
                            if a.isVolcano ~= b.isVolcano then
                                return a.isVolcano == true
                            end
                            local wA = RarityWeights[a.rarity] or 0
                            local wB = RarityWeights[b.rarity] or 0
                            if wA ~= wB then
                                return wA > wB
                            end
                            return a.dist < b.dist
                        end)

                        local target = candidates[1]
                        local targetPos = target.pos
                        local activeId = target.activeName or target.name

                        char:PivotTo(CFrame.new(targetPos + Vector3.new(0, 1.8, 0)))
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        task.wait(0.18)

                        local initialBasket = #LocalPlayer.Basket:GetChildren()

                        if target.prompt and fireproximityprompt then
                            pcall(function()
                                fireproximityprompt(target.prompt)
                            end)
                        end
                        if target.activeName then
                            pcall(function()
                                EggPickup:FireServer(target.activeName)
                            end)
                        end

                        local pickedUp = false
                        local t0 = os.clock()
                        while (os.clock() - t0 < 0.65) and IsSessionAlive() do
                            task.wait(0.06)
                            if #LocalPlayer.Basket:GetChildren() > initialBasket then
                                pickedUp = true
                                break
                            end
                            if target.model and target.model.Parent == nil then
                                pickedUp = true
                                break
                            end
                        end

                        if not pickedUp then
                            failedEggs[activeId] = os.clock() + 20
                        elseif target.isVolcano then
                            Fluent:Notify({
                                Title = GetText("NotifySnipeEgg_Title"),
                                Content = GetText("NotifySnipeEgg_Content"),
                                Duration = 3.5
                            })
                        end

                        local newCur, newCap = GetBasketInfo()
                        if newCur >= newCap then
                            task.wait(0.08)
                            ReturnToPlot()
                            local depositStart = os.clock()
                            while #LocalPlayer.Basket:GetChildren() > 0 and (os.clock() - depositStart < 3.5) and IsSessionAlive() do
                                task.wait(0.12)
                            end
                            task.wait(0.2)
                        else
                            task.wait(Config.CollectDelay)
                        end
                    else
                        if Config.ReturnHomeAfterCollect then
                            local plot = GetPlayerPlot()
                            if plot and root then
                                local baseplate = plot:FindFirstChild("Baseplate")
                                local homePos = baseplate and baseplate.Position or plot:GetPivot().Position
                                local dist = (root.Position - homePos).Magnitude
                                if dist > 30 then
                                    ReturnToPlot()
                                end
                            end
                        end
                        task.wait(1.0)
                    end
                end
            end
        end
    end
end)

