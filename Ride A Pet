task.spawn(function()
    local blockedPhrases = {"not enough cash", "you need a horse"}

    local function IsBlocked(str)
        if not str then return false end
        local lower = str:lower()
        for _, phrase in ipairs(blockedPhrases) do
            if string.find(lower, phrase, 1, true) then
                return true
            end
        end
        return false
    end

    local function HandleMessage(child)
        if not child:IsA("GuiObject") then return end
        if IsBlocked(child.Name) then
            child.Visible = false
            child:Destroy()
            return
        end
        task.defer(function()
            if not child or not child.Parent then return end
            if IsBlocked(child.Name) then
                child.Visible = false
                child:Destroy()
                return
            end
            for _, desc in ipairs(child:GetDescendants()) do
                if desc:IsA("TextLabel") and IsBlocked(desc.Text) then
                    child.Visible = false
                    child:Destroy()
                    return
                end
            end
        end)
    end

    local function HookGameMessages()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return end
        local reusable = playerGui:FindFirstChild("Reusable")
        local gm = reusable and reusable:FindFirstChild("GameMessages")
        if gm then
            for _, c in ipairs(gm:GetChildren()) do
                HandleMessage(c)
            end
            gm.ChildAdded:Connect(HandleMessage)
        end
    end

    HookGameMessages()
    if LocalPlayer:FindFirstChild("PlayerGui") then
        LocalPlayer.PlayerGui.ChildAdded:Connect(function(child)
            if child.Name == "Reusable" then
                task.wait(0.1)
                HookGameMessages()
            end
        end)
    end
end)

