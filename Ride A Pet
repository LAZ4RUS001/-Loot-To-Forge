local isSaving = false
local function SaveAccountConfig(immediate)
    if isInitialLoading then return end
    if not (writefile and makefolder and isfolder) then return end
    local function executeSave()
        pcall(function()
            if not isfolder(accountFolder) then
                makefolder(accountFolder)
            end
            writefile(accountFileName, HttpService:JSONEncode(Config))
        end)
    end

    if immediate then
        executeSave()
        return
    end

    if isSaving then return end
    isSaving = true
    task.defer(function()
        isSaving = false
        executeSave()
    end)
end

local function GetPlayerPlot()
    if General and General.GetPlot then
        local p = General:GetPlot(LocalPlayer)
        if p then return p end
    end

    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        local data = plot:FindFirstChild("Data")
        if data then
            for _, c in ipairs(data:GetChildren()) do
                if c:IsA("ValueBase") and c.Value == LocalPlayer then
                    return plot
                end
            end
        end
    end
    return nil
end

local function ReturnToPlot()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local plot = GetPlayerPlot()
    if not (char and root and plot) then return false end

    local baseplate = plot:FindFirstChild("Baseplate")
    local targetCFrame = baseplate and (baseplate.CFrame * CFrame.new(0, 5, 0)) or (plot:GetPivot() * CFrame.new(0, 5, 0))
    local targetPos = targetCFrame.Position

    for i = 1, 4 do
        char:PivotTo(targetCFrame)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.04)
    end

    local TeleportToPlot = GameRemotes:FindFirstChild("TeleportToPlot")
    if TeleportToPlot then
        local basket = LocalPlayer:FindFirstChild("Basket")
        if not (basket and #basket:GetChildren() > 0) then
            pcall(function()
                TeleportToPlot:FireServer()
            end)
        end
    end

    local dist = (root.Position - targetPos).Magnitude
    return dist < 25
end

