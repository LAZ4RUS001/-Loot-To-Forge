local function ApplyConfigToUI()
    isInitialLoading = true
    pcall(function()
        if Fluent.Options.Language then Fluent.Options.Language:SetValue(Config.Language == "English" and "English" or "ไทย") end
        if Fluent.Options.TeleportCollectEggs then Fluent.Options.TeleportCollectEggs:SetValue(Config.TeleportCollectEggs) end
        if Fluent.Options.ReturnHomeAfterCollect then Fluent.Options.ReturnHomeAfterCollect:SetValue(Config.ReturnHomeAfterCollect) end
        if Fluent.Options.AutoCollectCash then Fluent.Options.AutoCollectCash:SetValue(Config.AutoCollectCash) end
        if Fluent.Options.AutoHatchReady then Fluent.Options.AutoHatchReady:SetValue(Config.AutoHatchReady) end
        if Fluent.Options.AutoHatchLuck then Fluent.Options.AutoHatchLuck:SetValue(Config.AutoHatchLuck) end
        if Fluent.Options.AutoRebirth then Fluent.Options.AutoRebirth:SetValue(Config.AutoRebirth) end
        if Fluent.Options.AutoClaimIndex then Fluent.Options.AutoClaimIndex:SetValue(Config.AutoClaimIndex) end
        if Fluent.Options.EggRarities then Fluent.Options.EggRarities:SetValue(GetOnlyTrueKeys(Config.SelectedRarities)) end
        if Fluent.Options.CollectDelay then Fluent.Options.CollectDelay:SetValue(Config.CollectDelay) end
        if Fluent.Options.AutoPlaceEggs then Fluent.Options.AutoPlaceEggs:SetValue(Config.AutoPlaceEggs) end
        if Fluent.Options.AutoPlaceBest then Fluent.Options.AutoPlaceBest:SetValue(Config.AutoPlaceBest) end
        if Fluent.Options.PlaceEggRarities then Fluent.Options.PlaceEggRarities:SetValue(GetOnlyTrueKeys(Config.PlaceRarities)) end
        if Fluent.Options.MaxPlotEggs then Fluent.Options.MaxPlotEggs:SetValue(Config.MaxPlotEggs) end
        if Fluent.Options.AutoVolcanoDip then Fluent.Options.AutoVolcanoDip:SetValue(Config.AutoVolcanoDip) end
        if Fluent.Options.SnipeVolcanicEgg then Fluent.Options.SnipeVolcanicEgg:SetValue(Config.SnipeVolcanicEgg) end
        if Fluent.Options.CustomSpeed then Fluent.Options.CustomSpeed:SetValue(Config.CustomSpeed) end
        if Fluent.Options.WalkSpeed then Fluent.Options.WalkSpeed:SetValue(Config.WalkSpeed) end
        if Fluent.Options.JumpPower then Fluent.Options.JumpPower:SetValue(Config.JumpPower) end
        if Fluent.Options.ShowFloatingButton then Fluent.Options.ShowFloatingButton:SetValue(Config.ShowFloatingButton) end
    end)
    UpdateLanguage(Config.Language)
    isInitialLoading = false
end

