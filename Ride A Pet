local function IsEggReadyToHatch(eggModel)
    if not eggModel or not eggModel.PrimaryPart or eggModel:HasTag("Hatching") then
        return false
    end
    local eggKey = eggModel:GetAttribute("EggKey")
    if not eggKey then return false end

    local eggData = eggModel:FindFirstChild("EggData")
    local placeTime = eggData and eggData:FindFirstChild("PlaceTime")
    local weight = eggData and eggData:FindFirstChild("Weight")
    local eggDef = EggsDB_Data[eggModel.Name]
    if not (eggDef and placeTime and placeTime.Value > 0) then
        return false
    end

    local elapsed = 0
    if eggModel:GetAttribute("FlatGrow") == true then
        elapsed = workspace:GetServerTimeNow() - placeTime.Value
    elseif DayNight and DayNight.GrowthElapsed then
        elapsed = DayNight.GrowthElapsed(placeTime.Value)
    else
        elapsed = workspace:GetServerTimeNow() - placeTime.Value
    end

    local required = eggDef.GrowthTime or 0
    if General2 and General2.GrowthTimeFor then
        required = General2.GrowthTimeFor(eggDef.GrowthTime, weight and weight.Value or 1)
    end

    return elapsed >= required
end

