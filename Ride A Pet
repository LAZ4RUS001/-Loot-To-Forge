local function GetText(key, ...)
    local lang = (Config.Language == "English") and "EN" or "TH"
    local str = (Locales[lang] and Locales[lang][key]) or (Locales.EN and Locales.EN[key]) or key
    if select("#", ...) > 0 then
        return string.format(str, ...)
    end
    return str
end

local function GetVolcanoStatusText()
    local RS = game:GetService("ReplicatedStorage")
    local SD = RS:FindFirstChild("ServerData")
    local revealed = (SD and SD:GetAttribute("VolcanoRevealed") == true)
    local statusStr = revealed and ((Config.Language == "English") and "Active / Revealed" or "เปิดอยู่ (Active)") or ((Config.Language == "English") and "Hidden" or "ซ่อนอยู่ (Hidden)")

    local distStr = "--"
    local inRangeStr = (Config.Language == "English") and "Not In Range" or "อยู่นอกระยะ"
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local volcanoPos = Vector3.new(-5102.84, 41405.63, -3489.11)
    if root then
        local dist = math.floor((root.Position - volcanoPos).Magnitude)
        distStr = tostring(dist)
        if dist <= 400 then
