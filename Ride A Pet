    for _, item in ipairs(tabPairs) do
        local tabObj, title = item[1], item[2]
        if tabObj then
            pcall(function()
                tabObj.Name = title
                if tabObj.Frame then
                    local lbl = tabObj.Frame:FindFirstChildWhichIsA("TextLabel")
